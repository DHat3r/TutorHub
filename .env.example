# Copia este archivo a .env:  cp .env.example .env
# Los valores sirven tal cual para desarrollo local. En producción cambia los secretos.

# Base de datos (docker compose usa estos valores para crear Postgres)
POSTGRES_USER=tutorhub
POSTGRES_PASSWORD=tutorhub
POSTGRES_DB=tutorhub
# Puerto de Postgres en tu máquina (cámbialo si ya usas el 5432)
DB_PORT=5432
# Solo si corres la API fuera de Docker:
DATABASE_URL=postgresql://tutorhub:tutorhub@localhost:5432/tutorhub

# Secretos de los JWT (genera unos propios: openssl rand -hex 32)
JWT_SECRET=cambia-este-secreto-de-desarrollo
JWT_FORGOT_PASSWORD=cambia-este-otro-secreto-de-desarrollo

# URLs públicas (las usa el navegador y los enlaces de los correos)
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:3001

# Correo. En Docker se usa Mailpit; fuera de Docker apunta a tu SMTP.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM='"TutorHub" <no-reply@tutorhub.local>'

# Opcional: login con Google. Vacío = desactivado.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Opcional: restringe Google a un dominio (por ejemplo mail.udp.cl)
ALLOWED_EMAIL_DOMAIN=

# Contraseña de los usuarios de demo que crea el seed
SEED_DEMO_PASSWORD=demo1234
